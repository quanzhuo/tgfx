@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(TGFX_VERSION "@TGFX_VERSION@")
set(TGFX_STATIC_LIBRARY ON)
set(TGFX_SHARED_LIBRARY OFF)

set(TGFX_BUILD_SVG "@TGFX_BUILD_SVG@")
set(TGFX_BUILD_PDF "@TGFX_BUILD_PDF@")
set(TGFX_BUILD_LAYERS "@TGFX_BUILD_LAYERS@")
set(TGFX_USE_OPENGL "@TGFX_USE_OPENGL@")
set(TGFX_USE_QT "@TGFX_USE_QT@")
set(TGFX_USE_SWIFTSHADER "@TGFX_USE_SWIFTSHADER@")
set(TGFX_USE_ANGLE "@TGFX_USE_ANGLE@")
set(TGFX_USE_NATIVE_GL "@TGFX_USE_NATIVE_GL@")
set(TGFX_USE_THREADS "@TGFX_USE_THREADS@")
set(TGFX_USE_FREETYPE "@TGFX_USE_FREETYPE@")
set(TGFX_USE_PNG "@TGFX_USE_PNG@")
set(TGFX_USE_PNG_DECODE "@TGFX_USE_PNG_DECODE@")
set(TGFX_USE_PNG_ENCODE "@TGFX_USE_PNG_ENCODE@")
set(TGFX_USE_JPEG "@TGFX_USE_JPEG@")
set(TGFX_USE_JPEG_DECODE "@TGFX_USE_JPEG_DECODE@")
set(TGFX_USE_JPEG_ENCODE "@TGFX_USE_JPEG_ENCODE@")
set(TGFX_USE_WEBP "@TGFX_USE_WEBP@")
set(TGFX_USE_WEBP_DECODE "@TGFX_USE_WEBP_DECODE@")
set(TGFX_USE_WEBP_ENCODE "@TGFX_USE_WEBP_ENCODE@")
set(TGFX_USE_TEXT_GAMMA_CORRECTION "@TGFX_USE_TEXT_GAMMA_CORRECTION@")
set(TGFX_EMBEDDED_STATIC_VENDORS "@TGFX_STATIC_VENDORS@")

set(TGFX_CONFIG_NEEDS_THREADS "@TGFX_CONFIG_NEEDS_THREADS@")
if (TGFX_CONFIG_NEEDS_THREADS)
    find_dependency(Threads)
endif ()

set(TGFX_CONFIG_NEEDS_QT "@TGFX_CONFIG_NEEDS_QT@")
if (TGFX_CONFIG_NEEDS_QT)
    find_dependency(Qt@TGFX_CONFIG_QT_MAJOR@ REQUIRED COMPONENTS Widgets OpenGL Quick)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/TGFXTargets.cmake")
check_required_components(TGFX)
